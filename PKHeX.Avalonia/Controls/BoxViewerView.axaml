<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PKHeX.Avalonia.ViewModels"
             xmlns:controls="using:PKHeX.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="PKHeX.Avalonia.Controls.BoxViewerView"
             x:DataType="vm:BoxViewerViewModel">

    <Grid RowDefinitions="*, Auto" Margin="2">
        <!-- PC Box Grid Container -->
        <Border Grid.Row="0" Classes="card" Padding="10" Margin="0,0,0,8" IsVisible="{Binding HasBox}">
            <Grid RowDefinitions="Auto, *">
                <!-- PC Storage Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,4,8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="PC Storage" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CurrentBoxName, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TotalSlotsText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Dynamic Dimension Grid -->
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
                    <ItemsControl ItemsSource="{Binding BoxSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlotViewModel">
                                <controls:SlotControl 
                                    SlotViewRequested="OnSlotView"
                                    SlotSetRequested="OnSlotSet"
                                    SlotCloneRequested="OnSlotClone"
                                    SlotDeleteRequested="OnSlotDelete"
                                    SlotSwapRequested="OnSlotSwap"
                                    SlotFileDropped="OnSlotFileDropped" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Grid>
        </Border>

        <!-- Party Dock Tray (6 slots) -->
        <Border Grid.Row="1" Classes="card" Padding="10" IsVisible="{Binding HasParty}">
            <Grid RowDefinitions="Auto, Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,4,6">
                    <TextBlock Grid.Column="0" Text="Party Pokémon" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="6 Slots" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding PartySlots}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotViewModel">
                            <controls:SlotControl 
                                SlotViewRequested="OnSlotView"
                                SlotSetRequested="OnSlotSet"
                                SlotCloneRequested="OnSlotClone"
                                SlotDeleteRequested="OnSlotDelete"
                                SlotSwapRequested="OnSlotSwap"
                                SlotFileDropped="OnSlotFileDropped" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
