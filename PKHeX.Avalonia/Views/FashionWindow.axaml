<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PKHeX.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="540"
        x:Class="PKHeX.Avalonia.Views.FashionWindow"
        x:DataType="vm:FashionViewModel"
        Title="Fashion &amp; Wardrobe Boutique (Legends Z-A)"
        Width="740" Height="580"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto, *, Auto" Margin="16">
        <!-- Boutique Banner -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="👗 Lumiose Boutique &amp; Salon Wardrobe" FontWeight="Bold" FontSize="18" Foreground="#D81B60" />
                    <TextBlock Text="Manage unlocked clothing, shoes, satchels, accessories, hairstyles, and cosmetics." FontSize="12" Foreground="Gray" />
                </StackPanel>
                <Button Grid.Column="1" Content="✨ Unlock All Wardrobe Items" Click="OnUnlockAllClick"
                        Background="#D81B60" Foreground="White" FontWeight="Bold" Height="32" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Category Grid -->
        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FashionCategoryViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                                    CornerRadius="6" Padding="12" Margin="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                            CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#1E88E5" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" Margin="0,14,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#1E88E5" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" Width="90" Height="32" HorizontalContentAlignment="Center" />
                <Button Content="Save Fashion" Click="OnSaveClick" Width="140" Height="32"
                        Background="#2E7D32" Foreground="White" FontWeight="SemiBold" HorizontalContentAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
