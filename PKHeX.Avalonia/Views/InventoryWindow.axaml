<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PKHeX.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
        x:Class="PKHeX.Avalonia.Views.InventoryWindow"
        x:DataType="vm:InventoryViewModel"
        Title="Bag / Inventory Editor"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*, Auto" Margin="16">
        <!-- Main Content (Pouch List + Pouch Items) -->
        <Grid Grid.Row="0" ColumnDefinitions="220, 12, *">
            <!-- Left: Pouch Selector -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="Bag Pouches" FontWeight="Bold" FontSize="14" Margin="6,4,6,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Pouches}"
                             SelectedItem="{Binding SelectedPouch, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:InventoryPouchViewModel">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding PouchName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}" 
                                            CornerRadius="10" Padding="6,2">
                                        <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="Gray" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Pouch Editor -->
            <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowDefinitions="Auto, Auto, *">
                    <!-- Pouch Title + Actions -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedPouch.PouchName, StringFormat='{}Pouch: {0}'}" 
                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Give Legal All" Click="OnGiveAllClick" Height="30" FontSize="12" ToolTip.Tip="Fill pouch with all legal items" />
                            <Button Content="Sort A-Z" Click="OnSortClick" Height="30" FontSize="12" />
                            <Button Content="Clear All" Click="OnClearClick" Height="30" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- Add Item Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}" 
                            CornerRadius="6" Padding="8" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*, 80, Auto">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableItems}"
                                      SelectedValue="{Binding SelectedNewItemId, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Value}"
                                      DisplayMemberBinding="{Binding Text}"
                                      HorizontalAlignment="Stretch" Height="32" Margin="0,0,8,0" />
                            <NumericUpDown Grid.Column="1" Value="{Binding NewItemCount, Mode=TwoWay}" 
                                           Minimum="1" Maximum="999" Height="32" FormatString="0" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="+ Add Item" Click="OnAddItemClick" Height="32" />
                        </Grid>
                    </Border>

                    <!-- Items List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedPouch.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InventoryItemViewModel">
                                    <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                                            CornerRadius="6" Padding="8,4" Margin="0,2">
                                        <Grid ColumnDefinitions="40, *, 100, 40">
                                            <!-- Item Icon -->
                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Item Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />

                                            <!-- Quantity Stepper -->
                                            <NumericUpDown Grid.Column="2" Classes="stat" Value="{Binding Count, Mode=TwoWay}" 
                                                           Minimum="1" Maximum="{Binding MaxCount}" Margin="4,0" />

                                            <!-- Delete Button -->
                                            <Button Grid.Column="3" Content="✕" Click="OnDeleteItemClick" 
                                                    Width="28" Height="28" Padding="0" 
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                                                    Foreground="#E53935" ToolTip.Tip="Remove Item" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Dialog Actions -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="0,14,0,0">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" Width="90" Height="32" HorizontalContentAlignment="Center" />
                <Button Content="Save to Bag" Click="OnSaveClick" Width="120" Height="32" 
                        Background="#2E7D32" Foreground="White" FontWeight="SemiBold" HorizontalContentAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
