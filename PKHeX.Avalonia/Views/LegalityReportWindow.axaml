<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PKHeX.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="560"
        x:Class="PKHeX.Avalonia.Views.LegalityReportWindow"
        x:DataType="vm:LegalityReportViewModel"
        Title="Legality Analysis Report"
        Width="700" Height="580"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto, *, Auto" Margin="16">
        <!-- Top Status Banner -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding HeaderText}" Foreground="{Binding HeaderColor}" FontWeight="Bold" FontSize="18" />
                    <TextBlock Text="{Binding EncounterSummary, StringFormat='Matched Encounter: {0}'}" FontSize="12" Foreground="Gray" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs (Check Items vs Full Report) -->
        <TabControl Grid.Row="1">
            <!-- Tab 1: Check Items -->
            <TabItem Header="Detailed Diagnostics">
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0">
                    <ListBox ItemsSource="{Binding Checks}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LegalityCheckItemViewModel">
                                <Grid ColumnDefinitions="30, 140, *" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding SeverityIcon}" Foreground="{Binding SeverityColor}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontWeight="SemiBold" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>

            <!-- Tab 2: Full Report Text -->
            <TabItem Header="Verbose Text Report">
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0">
                    <TextBox Text="{Binding FullReport}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas, Menlo, monospace" FontSize="12"
                             Background="Transparent" BorderThickness="0" />
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Content="📋 Copy Report to Clipboard" Click="OnCopyClick" Height="32" />
            <Button Grid.Column="1" Content="Close" Click="OnCloseClick" Width="90" Height="32" HorizontalContentAlignment="Center" />
        </Grid>
    </Grid>
</Window>
