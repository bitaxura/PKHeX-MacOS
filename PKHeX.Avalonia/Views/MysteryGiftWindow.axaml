<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PKHeX.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
        x:Class="PKHeX.Avalonia.Views.MysteryGiftWindow"
        x:DataType="vm:MysteryGiftViewModel"
        Title="Mystery Gift / Wonder Card Editor"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*, Auto" Margin="16">
        <Grid Grid.Row="0" ColumnDefinitions="320, 12, *">
            <!-- Left: Card List -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="Wonder Card Album" FontWeight="Bold" FontSize="14" Margin="6,4,6,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Cards}"
                             SelectedItem="{Binding SelectedCard, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MysteryGiftCardViewModel">
                                <Grid ColumnDefinitions="40, *, Auto" Margin="0,2">
                                    <Image Grid.Column="0" Source="{Binding Sprite}" Width="32" Height="32" Stretch="None" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding DisplayIndex}" FontSize="11" Foreground="Gray" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- Status Pill -->
                                    <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                                            CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GiftUsed, Converter={x:Static ObjectConverters.IsNull}}" FontSize="10" Foreground="Gray" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Selected Card Details -->
            <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid RowDefinitions="Auto, *, Auto, Auto">
                    <!-- Title & Used Toggle -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedCard.Title}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" Content="Gift Used" IsChecked="{Binding SelectedCard.GiftUsed, Mode=TwoWay}"
                                  IsEnabled="{Binding SelectedCard.IsEmpty, Converter={x:Static BoolConverters.Not}}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Description -->
                    <TextBox Grid.Row="1" Text="{Binding SelectedCard.Description}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                             BorderThickness="0" CornerRadius="6" Padding="10" Margin="0,0,0,12" />

                    <!-- Status Bar -->
                    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#1E88E5" FontSize="12" Margin="0,0,0,10" />

                    <!-- Card Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button Content="Import Card..." Click="OnImportCardClick" Height="32" />
                        <Button Content="Export Card..." Click="OnExportCardClick" Height="32" IsEnabled="{Binding SelectedCard.IsEmpty, Converter={x:Static BoolConverters.Not}}" />
                        <Button Content="Receive to Editor" Click="OnReceiveToEditorClick" Height="32" IsEnabled="{Binding SelectedCard.IsEmpty, Converter={x:Static BoolConverters.Not}}" />
                        <Button Content="Clear Card" Click="OnClearCardClick" Height="32" IsEnabled="{Binding SelectedCard.IsEmpty, Converter={x:Static BoolConverters.Not}}" Foreground="#E53935" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Dialog Actions -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="0,14,0,0">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" Width="90" Height="32" HorizontalContentAlignment="Center" />
                <Button Content="Save Wonder Cards" Click="OnSaveClick" Width="150" Height="32"
                        Background="#2E7D32" Foreground="White" FontWeight="SemiBold" HorizontalContentAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
