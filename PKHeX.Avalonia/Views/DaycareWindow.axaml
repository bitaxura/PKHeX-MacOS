<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="480"
        x:Class="PKHeX.Avalonia.Views.DaycareWindow"
        x:DataType="vm:DaycareViewModel"
        Title="Daycare / Pokémon Nursery"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="16">
        <!-- Header -->
        <Border Grid.Row="0" Classes="card" Padding="12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="🏡 Pokémon Daycare / Nursery" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Manage Pokémon left in Daycare storage" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Egg Status -->
                <CheckBox Grid.Column="1" Content="🥚 Egg Available" IsChecked="{Binding HasEgg, Mode=TwoWay}"
                          IsVisible="{Binding HasEggState}" FontSize="12" FontWeight="SemiBold"
                          Foreground="{DynamicResource AccentWarningBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Slots List -->
        <Border Grid.Row="1" Classes="card" Padding="10">
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DaycareSlotViewModel">
                        <Border BorderBrush="#252530" BorderThickness="0,0,0,1" Padding="10,8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <!-- Sprite -->
                                <Border Grid.Column="0" Width="52" Height="52" Background="#14141A"
                                        BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="8"
                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Sprite}" Width="44" Height="44" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding LevelInfo}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <!-- Slot Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="👁️ View" Click="OnViewSlotClick"
                                            IsEnabled="{Binding HasPokemon}" Classes="subtle" Height="30" Padding="8,0"
                                            ToolTip.Tip="Load Pokémon into Editor" />
                                    <Button Content="📥 Deposit Editor" Click="OnDepositSlotClick"
                                            Classes="subtle" Height="30" Padding="8,0"
                                            ToolTip.Tip="Deposit Editor Pokémon into this slot" />
                                    <Button Content="🗑️ Clear" Click="OnClearSlotClick"
                                            IsEnabled="{Binding HasPokemon}" Classes="subtle" Height="30" Padding="8,0"
                                            ToolTip.Tip="Withdraw / empty slot" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,14,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" Classes="subtle" Width="90" Height="32" />
                <Button Content="Save Changes" Click="OnSaveClick" Classes="primary" Width="120" Height="32" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

